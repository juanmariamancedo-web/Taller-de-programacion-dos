{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/main/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./src/renderer/src",
    "paths": {
      "*": ["*"]
    }
  }
}